<%= form_for book, url: book.persisted? ? book_path(book, edit_token: params[:edit_token]) : books_path do |f| %>
  <% if book.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(book.errors.count, "error") %> prohibited this book from being saved:</h2>
      <ul>
        <% book.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= react_component("AdminBookForm", {
    book: book,
  }) %>

  <div class="actions text-center">
    <%= f.submit "Save Book", class: "btn btn-update" %>
  </div>
<% end %>

<% if book.persisted? %>
  <button type="button" id="delete-book-btn" class="btn btn-delete">Delete Book for All Users</button>
  <%= form_for book, url: book_path(book, edit_token: params[:edit_token]), method: :delete, html: { id: "delete-book-form", style: "display:none" } do |f| %>
  <% end %>
<% end %>

<div id="delete-confirm-modal" class="modal-overlay" style="display:none">
  <div class="modal-box">
    <h3>Delete Book</h3>
    <p>Are you sure you want to delete <strong><%= book.name %></strong>? This will remove it for all users.</p>
    <div class="modal-actions">
      <button id="delete-cancel-btn" class="btn btn-cancel">Cancel</button>
      <button id="delete-confirm-btn" class="btn btn-delete">Delete</button>
    </div>
  </div>
</div>
