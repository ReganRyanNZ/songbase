<div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">
  <%= @is_new_song ? "New song" : "Song update" %>: “<%= @song.title %>” (<%= @song.lang %>)
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#ffffff; padding:24px 0;">
  <tr>
    <td align="center">
      <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px; width:100%; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; color:#1f2328; font-size:15px; line-height:1.6;">

        <tr>
          <td style="padding:8px 32px 0;">
            <div style="font-size:13px; letter-spacing:0.14em; text-transform:uppercase; color:#6e7781; font-weight:600;">Songbase</div>
          </td>
        </tr>

        <tr>
          <td style="padding:16px 32px 0;">
            <h1 style="margin:0; font-size:22px; font-weight:700; color:#1f2328;"><%= @song.title %></h1>
            <p style="margin:4px 0 0; font-size:13px; color:#6e7781;">
              <%= @song.lang %> &middot; <%= @is_new_song ? "new song" : "updated" %><%= " &middot; by #{@editor_name}" if @editor_name %>
            </p>
          </td>
        </tr>

        <% if !@is_new_song && @attr_changes.any? %>
          <% @attr_changes.each do |attribute, old_value, new_value| %>
            <tr>
              <td style="padding:18px 32px 0;">
                <div style="font-size:13px; color:#6e7781; text-transform:uppercase; letter-spacing:0.08em; font-weight:600; margin-bottom:2px;"><%= attribute.humanize %></div>
                <div style="font-size:14px;">
                  <span style="color:#6e7781;"><%= old_value.presence || "(empty)" %></span>
                  <span style="color:#6e7781;">&rarr;</span>
                  <strong style="font-weight:600;"><%= new_value.presence || "(empty)" %></strong>
                </div>
              </td>
            </tr>
          <% end %>
        <% end %>

        <% if @lyrics_rows.any? %>
          <tr>
            <td style="padding:18px 32px 0;">
              <div style="font-size:13px; color:#6e7781; text-transform:uppercase; letter-spacing:0.08em; font-weight:600; margin-bottom:6px;">
                Lyrics<% if @is_new_song %> &mdash; new<% end %>
              </div>
              <%# Rows are emitted tight (content flush inside the cells):
                  the content cell uses white-space:pre-wrap, so any template
                  indentation inside a cell would be rendered and blow up the
                  row height. %>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace; font-size:13px; line-height:1.5; color:#1f2328; border:1px solid #eaecef; border-radius:6px; overflow:hidden;">
                <% backgrounds = { removed: "#fdd", added: "#dfd", context: "#f8f8f8" }
                   prefixes = { removed: "&minus;".html_safe, added: "+", context: "&nbsp;".html_safe } %>
                <% @lyrics_rows.each do |kind, line| %>
<tr><td width="24" valign="top" style="padding:0 4px 0 10px; background:<%= backgrounds[kind] %>; color:#6e7781; font-weight:700; white-space:nowrap;"><%= prefixes[kind] %></td><td valign="top" style="padding:0 10px 0 0; background:<%= backgrounds[kind] %>; white-space:pre-wrap; word-break:break-word;"><%= line.presence || "&nbsp;".html_safe %></td></tr>
                <% end %>
              </table>
            </td>
          </tr>
        <% end %>

        <tr>
          <td style="padding:22px 32px 0; font-size:14px;">
            <a href="<%= @song_url %>" style="color:#1f2328; font-weight:600; text-decoration:underline;">View song in Songbase</a>
          </td>
        </tr>

        <tr>
          <td style="padding:24px 32px 0;">
            <hr style="border:none; border-top:1px solid #eaecef; margin:0;">
          </td>
        </tr>

        <tr>
          <td style="padding:16px 32px 28px; color:#6e7781; font-size:12px; line-height:1.5;">
            You're receiving this because you oversee the <%= @song.lang %> song collection.<br>
            Questions? Reply to this email or write to <a href="mailto:songbase.brothers@gmail.com" style="color:#1f2328;">songbase.brothers@gmail.com</a>.
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
