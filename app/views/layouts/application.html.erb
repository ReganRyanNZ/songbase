<!DOCTYPE html>
<html>
  <head>
    <title><%= @title || "Songbase" %></title>
    <%= csrf_meta_tags %>
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google" content="notranslate">
    <meta name="google-site-verification" content="37ffvoSa1-N_lySTBC3xeLJozjNWNh0Sy-rI9g3DBVY" />
    <meta name="description" content="Songbook for psalms, hymns, and spiritual songs" />
    <meta name="robots" content="noindex">

    <meta charset="UTF-8" />
    <%= render partial: "layouts/clerk_handshake_cleanup" %>
    <% if clerk_publishable_key.present? && clerk_frontend_api_url.present? %>
      <%# Clerk JS keeps the session token fresh (the __session cookie's JWT
          expires every ~60s) so that authenticated fetch() calls — e.g. the
          admin song list — don't trip the middleware's handshake-on-expiry
          redirect, which only works for full-page navigations. Loaded on every
          page that uses this layout (admin/edit/etc.); the public app uses a
          separate layout and stays lightweight. %>
      <script defer crossorigin="anonymous"
              data-clerk-publishable-key="<%= clerk_publishable_key %>"
              src="https://<%= clerk_frontend_api_url %>/npm/@clerk/clerk-js@6/dist/clerk.browser.js"></script>
    <% end %>
    <link rel="icon" type="image/svg+xml" sizes="any" href="/logo.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" >
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="manifest" href=<%= asset_path "manifest.json" %> />

    <%= stylesheet_link_tag    'application', media: 'all' %>
    <%= javascript_include_tag 'application' %>
  </head>

  <body class="<%= yield(:body_class) %>">
    <script>
      (function() {
        var saved = localStorage.getItem('cssTheme') || 'css-normal';
        // Swap only the theme class (css-normal / css-night), preserving any
        // other body classes such as "admin" (set via layouts). The old code
        // used removeAttribute('class'), which stripped the admin class.
        var THEMES = ['css-normal', 'css-night'];
        function apply(theme) {
          document.body.classList.remove.apply(document.body.classList, THEMES);
          document.body.classList.add(theme);
        }
        apply(saved);
        window.setTheme = function(theme) {
          apply(theme);
          localStorage.setItem('cssTheme', theme);
        };
      })();
    </script>
    <div class="application-container">
      <%= yield :header %>
      <%= yield %>
    </div>
  </body>
</html>
